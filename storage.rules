rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images — public read (shown on the storefront); only signed-in
    // admins can upload or delete.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Everything else is locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if the request is from an authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Orders collection:
    // - Anyone (unauthenticated storefront customers) can create orders.
    // - Unauthenticated customers can also update their pending order to paid (after Paystack payment).
    // - Only authenticated admins can read, list, update any field, or delete orders.
    match /orders/{orderId} {
      allow create: if true;
      allow update: if isAdmin() || (
        resource.data.status == 'pending' &&
        request.resource.data.status == 'paid' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'reference', 'paystackChannel'])
      );
      allow read, delete: if isAdmin();
    }

    // Products collection:
    // - Anyone can read the storefront product catalog.
    // - Only authenticated admins can create, update, or delete products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings collection (e.g., shipping rates, delivery zones):
    // - Anyone can read store configuration.
    // - Only authenticated admins can modify settings.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
